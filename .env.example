# Variables d'environnement — MODÈLE. Aucune valeur réelle ici, jamais.
#
# Deux familles distinctes, et la distinction est importante :
#   - celles préfixées NEXT_PUBLIC_ sont FIGÉES DANS LE BUNDLE au build et donc
#     visibles de tous. N'y mettre que du public.
#   - les autres sont des SECRETS DE LA FONCTION EDGE. Elles ne sont jamais lues
#     par Next : elles se posent avec `supabase secrets set`, côté Supabase.

# --------------------------------------------------------------------------
# Front (public) — copier dans .env.local pour le développement
# --------------------------------------------------------------------------

# URL de la fonction Edge `contact`, de la forme
# https://<ref-du-projet>.supabase.co/functions/v1/contact
# En production elle est fournie au build par le workflow GitHub Actions
# (variable de dépôt du même nom). Vide = le formulaire retombe sur le mailto.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# --------------------------------------------------------------------------
# Secrets de la fonction Edge — NE JAMAIS committer, ne jamais préfixer NEXT_PUBLIC_
# Poser avec :  npx supabase secrets set --env-file supabase/.env.local
# --------------------------------------------------------------------------

# Clé API Resend (commence par re_).
RESEND_API_KEY=

# Expéditeur de la notification. Le domaine doit être vérifié chez Resend.
# Ex. : "FRAGMENT <contact@votre-domaine.fr>"
CONTACT_FROM_EMAIL=

# Adresse de l'atelier qui reçoit les demandes.
CONTACT_TO_EMAIL=

# Origines autorisées à appeler la fonction, séparées par des virgules.
# Ex. : https://alibobo222.github.io,http://localhost:3000
# Vide = toutes les origines (à ne garder qu'en développement).
CONTACT_ALLOWED_ORIGINS=

# Sel du condensé d'adresse IP utilisé pour la limitation de fréquence.
# Une chaîne aléatoire longue, générée une fois : openssl rand -hex 32
CONTACT_IP_SALT=

# --------------------------------------------------------------------------
# NON REQUIS — pour mémoire
# --------------------------------------------------------------------------
# SUPABASE_URL et SUPABASE_SERVICE_ROLE_KEY sont injectées AUTOMATIQUEMENT dans
# les fonctions Edge par la plateforme. Ne pas les déclarer en secret : le
# préfixe `SUPABASE_` est réservé et `supabase secrets set` les rejette.
# La clé `service_role` ne doit apparaître nulle part dans ce dépôt.
